routes/, middleware/, models/, views/) and its real dependencies. Traces to NFR6 (layered structure) and FR1–FR8." style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="700" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 - Data Model (Class Diagram)"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="User" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="280" height="30" as="geometry"/></mxCell><mxCell id="c3" value="_id : ObjectId&#10;name : String {required}&#10;email : String {unique, required}&#10;password : String  (bcrypt hash)&#10;role : enum[user, admin] = &#x27;user&#x27;&#10;created_at : Date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="280" height="136" as="geometry"/></mxCell><mxCell id="c4" value="Bug" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="320" height="30" as="geometry"/></mxCell><mxCell id="c5" value="_id : ObjectId&#10;title : String {required, &gt;=3 chars}&#10;description : String {required}&#10;category : enum[UI, Functionality,&#10;  Performance, Security, Other]&#10;priority : enum[Low, Medium, High]&#10;status : enum[Open, In Progress,&#10;         Resolved] = &#x27;Open&#x27;&#10;reporterId : ObjectId -&gt; User {required}&#10;assignedTo : ObjectId -&gt; User {nullable,&#10;  set to the triaging admin on save}&#10;created_at / updated_at : Date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="320" height="256" as="geometry"/></mxCell><mxCell id="e6" value="reporterId   (1 User — 0..* Bug)" style="endArrow=none;html=1;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="assignedTo   (0..1 User — 0..* Bug)" style="endArrow=none;html=1;fontSize=11;exitX=1;exitY=0.6;entryX=0;entryY=0.6;dashed=1;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="Data model as actually implemented in models/User.js and models/Bug.js (Mongoose schemas, backed by MongoDB). Two collections only — there is no comment/collaboration table in this codebase. assignedTo is never chosen by the admin directly: routes/admin.js sets it to the editing admin&#x27;s own session id on every save (see FR7, and the UI copy in manage-bug.ejs: &quot;Saving will assign this bug to you&quot;)." style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="760" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 - Sequence - Report and Triage"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Reporter" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="210" height="70" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="100" as="sourcePoint"/><mxPoint x="145.0" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="30" width="210" height="50" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="80" as="sourcePoint"/><mxPoint x="385.0" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="Express App&#10;(routes + middleware)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="210" height="50" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="80" as="sourcePoint"/><mxPoint x="625.0" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="MongoDB&#10;(Mongoose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="30" width="210" height="50" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="80" as="sourcePoint"/><mxPoint x="865.0" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="Admin" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="30" width="210" height="70" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="100" as="sourcePoint"/><mxPoint x="1105.0" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e12" value="1: open /report-bug, fill form" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="140" as="sourcePoint"/><mxPoint x="385.0" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e13" value="2: POST /report-bug {title, description, category, priority}" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="184" as="sourcePoint"/><mxPoint x="625.0" y="184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="alt: not authenticated -&gt; requireLogin flashes &#x27;Please log in first.&#x27;, redirects to /login" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#b85450;fillColor=#fff2f2;align=left;fontSize=10;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="395.0" y="198" width="260" height="40" as="geometry"/></mxCell><mxCell id="c15" value="alt: missing field / title &lt;3 chars / invalid category or priority -&gt; flash error, redirect back to /report-bug" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#b85450;fillColor=#fff2f2;align=left;fontSize=10;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="395.0" y="244" width="260" height="40" as="geometry"/></mxCell><mxCell id="e16" value="3: Bug.create({...status:&#x27;Open&#x27;, reporterId})" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="320" as="sourcePoint"/><mxPoint x="865.0" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="4: saved Bug document" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="364" as="sourcePoint"/><mxPoint x="625.0" y="364" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="5: redirect -&gt; /dashboard (flash: reported)" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="408" as="sourcePoint"/><mxPoint x="385.0" y="408" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="6: show dashboard (new bug, status = Open)" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="452" as="sourcePoint"/><mxPoint x="145.0" y="452" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="7: open /admin" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="496" as="sourcePoint"/><mxPoint x="385.0" y="496" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e21" value="8: GET /admin" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="540" as="sourcePoint"/><mxPoint x="625.0" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="alt: role != &#x27;admin&#x27; -&gt; requireAdmin flashes &#x27;Administrator access required.&#x27;, redirects to /dashboard (not a hard 403)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#b85450;fillColor=#fff2f2;align=left;fontSize=10;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="395.0" y="554" width="260" height="40" as="geometry"/></mxCell><mxCell id="e23" value="9: Bug.find().sort().populate(reporterId, assignedTo)" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="630" as="sourcePoint"/><mxPoint x="865.0" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e24" value="10: every bug, all reporters" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="674" as="sourcePoint"/><mxPoint x="625.0" y="674" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="11: render admin-dashboard" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="718" as="sourcePoint"/><mxPoint x="385.0" y="718" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="12: view full bug list" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="762" as="sourcePoint"/><mxPoint x="1105.0" y="762" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e27" value="13: open bug, set priority / status, submit" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="806" as="sourcePoint"/><mxPoint x="385.0" y="806" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e28" value="14: POST /admin/bug/:id {priority, status}" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="850" as="sourcePoint"/><mxPoint x="625.0" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="alt: invalid priority or status value -&gt; flash error, redirect back to /admin/bug/:id before any write" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#b85450;fillColor=#fff2f2;align=left;fontSize=10;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="395.0" y="864" width="260" height="40" as="geometry"/></mxCell><mxCell id="e30" value="15: bug.priority=..; status=..; assignedTo=admin&#x27;s id; save()" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="940" as="sourcePoint"/><mxPoint x="865.0" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e31" value="16: updated Bug document" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="984" as="sourcePoint"/><mxPoint x="625.0" y="984" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e32" value="17: redirect -&gt; /admin (flash: updated)" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="1028" as="sourcePoint"/><mxPoint x="385.0" y="1028" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e33" value="18: view bug, now assigned to them" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="1072" as="sourcePoint"/><mxPoint x="1105.0" y="1072" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="End-to-end workflow 1 (FR4, FR6, FR7 / BT-4..BT-8): a bug is inert data until an Admin triages it — the two roles cannot complete this workflow alone. Note the admin never picks an assignee: saving the triage form assigns the bug to whichever admin is editing it (see data model note, page 2)." style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="900" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 - Sequence - Triage to Resolution"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Reporter" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="210" height="70" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="100" as="sourcePoint"/><mxPoint x="145.0" y="1460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="30" width="210" height="50" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="80" as="sourcePoint"/><mxPoint x="385.0" y="1460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="Express App&#10;(routes + middleware)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="210" height="50" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="80" as="sourcePoint"/><mxPoint x="625.0" y="1460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="MongoDB&#10;(Mongoose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="30" width="210" height="50" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="80" as="sourcePoint"/><mxPoint x="865.0" y="1460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="Admin" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="30" width="210" height="70" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=none;dashed=1;dashPattern=4 4;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="100" as="sourcePoint"/><mxPoint x="1105.0" y="1460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e12" value="1: revisit /admin later (bug already In Progress)" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="140" as="sourcePoint"/><mxPoint x="385.0" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e13" value="2: GET /admin" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="184" as="sourcePoint"/><mxPoint x="625.0" y="184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e14" value="3: Bug.find().sort().populate()" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="228" as="sourcePoint"/><mxPoint x="865.0" y="228" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e15" value="4: full bug list" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="272" as="sourcePoint"/><mxPoint x="625.0" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e16" value="5: render admin-dashboard" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="316" as="sourcePoint"/><mxPoint x="385.0" y="316" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="6: open the bug via /admin/bug/:id" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="360" as="sourcePoint"/><mxPoint x="385.0" y="360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="7: GET /admin/bug/:id" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="404" as="sourcePoint"/><mxPoint x="625.0" y="404" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="8: Bug.findById().populate(reporterId)" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="448" as="sourcePoint"/><mxPoint x="865.0" y="448" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="9: bug" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="492" as="sourcePoint"/><mxPoint x="625.0" y="492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e21" value="10: render manage-bug" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="536" as="sourcePoint"/><mxPoint x="385.0" y="536" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e22" value="11: set status = Resolved, submit" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="580" as="sourcePoint"/><mxPoint x="385.0" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="alt: invalid priority or status -&gt; flash error, redirect back before any write" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#b85450;fillColor=#fff2f2;align=left;fontSize=10;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="395.0" y="594" width="260" height="40" as="geometry"/></mxCell><mxCell id="e24" value="12: POST /admin/bug/:id {priority, status:&#x27;Resolved&#x27;}" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="670" as="sourcePoint"/><mxPoint x="625.0" y="670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="13: bug.status=&#x27;Resolved&#x27;; assignedTo=admin&#x27;s id; save()" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="714" as="sourcePoint"/><mxPoint x="865.0" y="714" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="14: updated" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="758" as="sourcePoint"/><mxPoint x="625.0" y="758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e27" value="15: redirect -&gt; /admin (flash: updated)" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="802" as="sourcePoint"/><mxPoint x="385.0" y="802" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e28" value="16: sees bug now Resolved" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="846" as="sourcePoint"/><mxPoint x="1105.0" y="846" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e29" value="17: later, open /dashboard" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="890" as="sourcePoint"/><mxPoint x="385.0" y="890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="alt: session belongs to an admin -&gt; blockAdminFromUserPages redirects /admin instead of showing this reporter view" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#b85450;fillColor=#fff2f2;align=left;fontSize=10;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="155.0" y="904" width="260" height="40" as="geometry"/></mxCell><mxCell id="e31" value="18: GET /dashboard" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="980" as="sourcePoint"/><mxPoint x="625.0" y="980" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e32" value="19: Bug.find({reporterId}).sort()" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="1024" as="sourcePoint"/><mxPoint x="865.0" y="1024" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e33" value="20: this reporter&#x27;s bugs only" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="865.0" y="1068" as="sourcePoint"/><mxPoint x="625.0" y="1068" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e34" value="21: render dashboard" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.0" y="1112" as="sourcePoint"/><mxPoint x="385.0" y="1112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e35" value="22: sees own bug, status = Resolved" style="endArrow=open;dashed=1;html=1;fontSize=11;align=center;verticalAlign=bottom;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385.0" y="1156" as="sourcePoint"/><mxPoint x="145.0" y="1156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="End-to-end workflow 2 (FR5, FR7 status progression to Resolved): distinct from workflow 1 — this covers an already-triaged bug being driven to completion and the Reporter independently confirming the final state on their own dashboard. There is no comment thread or reporter verify/reopen step in this codebase (see Requirements CL-6) — the Reporter&#x27;s only feedback loop is re-checking their dashboard." style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 - State Diagram - Bug Lifecycle"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="24" height="24" as="geometry"/></mxCell><mxCell id="c3" value="Open&#10;(default on create)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="190" width="220" height="80" as="geometry"/></mxCell><mxCell id="c4" value="In Progress" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="220" height="80" as="geometry"/></mxCell><mxCell id="c5" value="Resolved" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="220" height="80" as="geometry"/></mxCell><mxCell id="e6" value="create bug" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="admin sets status" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="admin sets status" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="⚠ Gap between design and implementation: the status &lt;select&gt; in views/manage-bug.ejs lists all 3 values every time and routes/admin.js&#x27;s POST /admin/bug/:id applies whichever one is submitted with no transition guard — an admin can jump straight from Open to Resolved, or back from Resolved to Open. This diagram shows the INTENDED lifecycle. Recommended enhancement: validate transitions server-side against this state machine (traces to NFR2 — input validation)." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#b85450;fillColor=#fff2f2;align=left;fontSize=10;dashed=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="180" y="340" width="760" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
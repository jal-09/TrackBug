<mxfile host="Claude" agent="BugTrack diagram generator" version="24.0.0"><diagram id="p1" name="1 - Component Diagram"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Reporter&#10;(role: user)" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="110" height="90" as="geometry"/></mxCell><mxCell id="c3" value="Admin&#10;(role: admin)" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1420" y="380" width="110" height="90" as="geometry"/></mxCell><mxCell id="c4" value="Browser&#10;(client — renders server HTML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="390" width="170" height="70" as="geometry"/></mxCell><mxCell id="c5" value="TrackBug — Express App (Node.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="900" height="520" as="geometry"/></mxCell><mxCell id="c6" value="Auth Middleware&#10;requireLogin() / requireAdmin() /&#10;blockAdminFromUserPages()&#10;(middleware/auth.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="380" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Session + Flash Middleware&#10;express-session, connect-mongo,&#10;custom req.flash() (app.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="380" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Auth Routes&#10;/register /login /logout&#10;(routes/auth.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="230" width="260" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Bug Routes&#10;/dashboard /report-bug&#10;(routes/bugs.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="260" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Admin Routes&#10;/admin /admin/bug/:id&#10;(routes/admin.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1010" y="230" width="260" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Mongoose Models&#10;User, Bug&#10;(models/*.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="550" y="350" width="300" height="70" as="geometry"/></mxCell><mxCell id="c12" value="EJS View Engine&#10;views/*.ejs + partials/flash.ejs&#10;(server-rendered HTML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="350" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="Session Store&#10;connect-mongo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="260" height="70" as="geometry"/></mxCell><mxCell id="c14" value="MongoDB Atlas&#10;users, bugs, sessions collections" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="300" height="110" as="geometry"/></mxCell><mxCell id="e15" value="uses" style="endArrow=block;html=1;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry">